# Copy to .env.local and fill in. Never commit real values.

# --- Supabase Auth (public by design) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…); a legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Postgres: the source of truth (server-only) ------------------------------
# Serverless hosting: Supavisor transaction pooler (port 6543).
# Long-running server / migrations: session pooler (5432) or the direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_POOL_MAX=5
# TLS (configure it here, not with ?sslmode in the URL — URL TLS parameters are ignored):
#   auto (default): no TLS for localhost; otherwise TLS, certificate-verified when DATABASE_SSL_CA is set
#   verify | require (encrypt without verifying) | disable
DATABASE_SSL=auto
# Recommended: the Supabase CA (Dashboard → Database settings → SSL configuration → download certificate).
# Paste the PEM; literal "\n" sequences are accepted for single-line env vars. Also enable "Enforce SSL" in Supabase.
DATABASE_SSL_CA=

# --- AI provider credentials (server-only) ------------------------------------
OPENAI_API_KEY=

# --- AI runtime: model/provider names live here, never in business code -------
# Reasoning effort per profile: default (send none — for models without reasoning support) | none | low | medium | high
AI_TEXT_PROVIDER=openai
AI_TEXT_MODEL=gpt-6-luna
AI_TEXT_REASONING_EFFORT=low
AI_ESCALATION_PROVIDER=openai
AI_ESCALATION_MODEL=gpt-6-sol
AI_ESCALATION_REASONING_EFFORT=medium
AI_ESCALATION_ENABLED=true
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) column in supabase/migrations.
AI_EMBEDDING_DIMENSIONS=1536

# Context budgets
AI_MAX_RETRIEVED_CHUNKS=5
AI_MAX_RETRIEVED_TOKENS=1800
AI_MAX_RECENT_MESSAGES=12
AI_MIN_RETRIEVAL_SIMILARITY=0.3
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_TOOL_ROUNDS=4
AI_REQUEST_TIMEOUT_MS=30000

# Optional per-model price overrides in USD per 1M tokens, merged over the built-in snapshot (src/server/config/pricing.ts):
# AI_MODEL_PRICING_JSON={"gpt-6-luna":{"inputPerMTok":0.1,"cachedInputPerMTok":0.01,"cacheWritePerMTok":0.125,"outputPerMTok":0.5}}

# Used from Phase 3/4 (phone / web voice) — not read yet:
# AI_VOICE_PROVIDER=openai
# AI_VOICE_MODEL=gpt-live-1

# --- Public web chat widget ---------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
WIDGET_SESSION_SECRET=
WIDGET_SESSION_TTL_HOURS=168
RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_WIDGET_PER_MINUTE=120
RATE_LIMIT_ORG_PER_MINUTE=300

# --- Operations -----------------------------------------------------------------
LOG_LEVEL=info

# Seed script only: email of an existing Supabase Auth user who will own the demo organization.
# SEED_OWNER_EMAIL=you@example.com
