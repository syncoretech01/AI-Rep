# Copy to .env.local and fill in. Never commit real values.

# --- Supabase Auth (public by design) ---------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_…); a legacy anon key also works.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Postgres: the source of truth (server-only) ------------------------------
# Serverless hosting: Supavisor transaction pooler (port 6543).
# Long-running server / migrations: session pooler (5432) or the direct connection.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<pooler-host>:6543/postgres
DATABASE_POOL_MAX=5
# TLS (configure it here, not with ?sslmode in the URL — URL TLS parameters are ignored):
#   auto (default): no TLS for localhost; otherwise TLS, certificate-verified when DATABASE_SSL_CA is set
#   verify | require (encrypt without verifying) | disable
# In production (NODE_ENV=production) a remote database REQUIRES verified TLS: the app refuses to start without
# DATABASE_SSL_CA, and npm run db:migrate refuses unless you pass --allow-unverified-tls.
DATABASE_SSL=auto
# The Supabase CA (Dashboard → Database settings → SSL configuration → download certificate).
# Paste the PEM; literal "\n" sequences are accepted for single-line env vars. Also enable "Enforce SSL" in Supabase.
DATABASE_SSL_CA=

# --- AI provider credentials (server-only) ------------------------------------
OPENAI_API_KEY=

# --- AI runtime: model/provider names live here, never in business code -------
# Reasoning effort per profile: default (send none — for models without reasoning support) | none | low | medium | high
AI_TEXT_PROVIDER=openai
AI_TEXT_MODEL=gpt-6-luna
AI_TEXT_REASONING_EFFORT=low
AI_ESCALATION_PROVIDER=openai
# Current Sol model (verified 2026-11-26); it rejects reasoning effort "none".
AI_ESCALATION_MODEL=gpt-6.2-sol
AI_ESCALATION_REASONING_EFFORT=medium
AI_ESCALATION_ENABLED=true
AI_EMBEDDING_PROVIDER=openai
AI_EMBEDDING_MODEL=text-embedding-3-small
# Must match the vector(1536) column in supabase/migrations.
AI_EMBEDDING_DIMENSIONS=1536

# Context budgets
AI_MAX_RETRIEVED_CHUNKS=5
AI_MAX_RETRIEVED_TOKENS=1800
AI_MAX_RECENT_MESSAGES=12
AI_MIN_RETRIEVAL_SIMILARITY=0.3
AI_MAX_OUTPUT_TOKENS=800
AI_MAX_TOOL_ROUNDS=4
AI_REQUEST_TIMEOUT_MS=30000

# Failure handling: same-model retries of 429 / timeouts / 5xx (jittered backoff, honours Retry-After and the turn
# deadline). Outages never switch to the escalation model. 0 disables retries.
AI_PROVIDER_MAX_RETRIES=2

# Cost and abuse controls (see AI_RUNTIME.md "Runtime cost controls")
AI_MAX_TOOL_CALLS_PER_TURN=6
AI_MAX_TURN_TOKENS=40000
AI_MAX_CONVERSATION_TURNS=100
AI_MAX_ESCALATED_CALLS_PER_CONVERSATION=6
# Estimated AI spend per organization (USD; UTC day / calendar month). Per-organization overrides:
# app_private.organization_limits (set by the platform operator). 0 blocks all AI calls.
AI_ORG_DAILY_SPEND_LIMIT_USD=10
AI_ORG_MONTHLY_SPEND_LIMIT_USD=150
# Label stored with every cost estimate; defaults to the date of the built-in price list.
# AI_PRICING_VERSION=2026-11-26

# Optional per-model price overrides in USD per 1M tokens, merged over the built-in snapshot (src/server/config/pricing.ts):
# AI_MODEL_PRICING_JSON={"gpt-6-luna":{"inputPerMTok":0.1,"cachedInputPerMTok":0.01,"cacheWritePerMTok":0.125,"outputPerMTok":0.5}}

# --- Realtime voice (Phase 2: voice gateway + developer voice lab) ----------------
# gpt-live-1.1 is a GPT-Live API model (/v1/live/sessions). Billed per second ($0.05/min active, $0.02/min standby).
AI_VOICE_PROVIDER=openai
AI_VOICE_MODEL=gpt-live-1.1
AI_VOICE_NAME=marin
# responses = OpenAI-hosted backend model answers, our tools run in the gateway (selected direction);
# client = our agent runtime answers each delegated turn (kept for measurement only).
AI_VOICE_DELEGATION=responses
# Backend model for Responses delegation (defaults to AI_TEXT_MODEL).
# AI_VOICE_DELEGATION_MODEL=
VOICE_MAX_SESSION_SECONDS=600
VOICE_MAX_CONCURRENT_SESSIONS=2
VOICE_SESSION_STARTS_PER_MINUTE=6
# Seconds without speech before the session drops to the cheaper standby rate (5-60).
VOICE_IDLE_TIMEOUT_SECONDS=20
# Delegated-model spend reserved per session minute on top of voice time (Responses delegation).
VOICE_DELEGATED_TEXT_RESERVE_PER_MINUTE_USD=0.01
# Where the app reaches the voice gateway (`npm run voice:gateway`), and the secret both share (≥ 32 random characters).
VOICE_GATEWAY_URL=http://127.0.0.1:4100
VOICE_GATEWAY_PORT=4100
VOICE_GATEWAY_SECRET=
# The developer voice page /o/<org>/voice-lab. Never enable in a deployed environment.
VOICE_DEV_ENABLED=false

# --- Public web chat widget ---------------------------------------------------
# At least 32 random characters, e.g. `openssl rand -base64 48`.
WIDGET_SESSION_SECRET=
WIDGET_SESSION_TTL_HOURS=168
RATE_LIMIT_IP_PER_MINUTE=20
RATE_LIMIT_WIDGET_PER_MINUTE=120
RATE_LIMIT_ORG_PER_MINUTE=300

# --- Operations -----------------------------------------------------------------
LOG_LEVEL=info

# Seed script only: email of an existing Supabase Auth user who will own the demo organization.
# SEED_OWNER_EMAIL=you@example.com

# npm run validate:live only (creates and deletes throwaway test users). NEVER used by the app; keep it out of the
# deployed environment.
# SUPABASE_SECRET_KEY=
